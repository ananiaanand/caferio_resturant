# Domain used for the INTERNAL random aliases (u<32 hex>@ALIAS_DOMAIN). Never shown to users,
# never mailed. Default: caferio-auth.invalid  (can never belong to anybody).
# If auth-register fails with `email_address_invalid`, GoTrue is validating the domain:
# use a domain you own instead, e.g.  ALIAS_DOMAIN=auth.yourdomain.com
ALIAS_DOMAIN=caferio-auth.invalid
